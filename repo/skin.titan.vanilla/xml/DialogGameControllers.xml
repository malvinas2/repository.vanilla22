<?xml version="1.0" encoding="UTF-8"?>
<window>
	<description>
		Window for game functionality. This dialog was originally for controllers,
		but adding new XML windows breaks old skins, so it has been repurposed
		for any game-related windows.
	</description>
	<defaultcontrol always="true">3</defaultcontrol>
			<!--Dialog Overlay-->
			<!-- <control type="group"> -->
				<!-- <visible>!Window.IsActive(1121)</visible> -->
				<!-- <include>DialogOverlayExtra</include> -->
				<!-- <animation effect="fade" time="250" start="0" end="100" reversible="false">WindowOpen</animation> -->
			<!-- </control> -->
	
	<controls>
		<include>animation_window_open_close</include>
		<!-- Window.IsDialogTopMost anstatt Window.IsActive nutzen ??? -->
		<include condition="Window.IsDialogTopMost(gamecontrollers)">GameDialogControllers</include>
		<include condition="Window.IsDialogTopMost(gameports)">GameDialogPorts</include>
		<include condition="Window.IsDialogTopMost(gameagents)">GameDialogAgents</include>
		<include condition="Window.IsDialogTopMost(gamediscmanager)">GameDialogDiscManager</include>
		<include condition="Window.IsDialogTopMost(gamecheats)">GameDialogCheats</include>
		<include condition="Window.IsDialogTopMost(gameindicators)">GameDialogIndicators</include>
		<include condition="Window.IsDialogTopMost(gameachievements) + RetroPlayer.AchievementsLoggedIn + Player.HasGame">GameDialogAchievements</include>
		<include content="GameDialogAchievements" condition="Window.IsDialogTopMost(gameachievements) + [!RetroPlayer.AchievementsLoggedIn | !Player.HasGame]">
			<param name="width" value="1740" />
			<param name="height" value="1000" />
		</include>
		<include condition="Window.IsDialogTopMost(gameleaderboards)">GameDialogLeaderboards</include>
		<include condition="Window.IsDialogTopMost(gameleaderboardentries)">GameDialogLeaderboardEntries</include>
		
		
	</controls>
</window>